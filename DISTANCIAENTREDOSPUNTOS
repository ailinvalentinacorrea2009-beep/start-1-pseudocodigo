
Algoritmo PuntoMedioDistancia ()

  Inicio

    Definir x1, y1, x2, y2 Como Real
    Definir distancia, medioX, medioY Como Real

      Escribir "Ingrese x1:"
        Leer x1

      Escribir "Ingrese y1:"
        Leer y1

      Escribir "Ingrese x2:"
        Leer x2

      Escribir "Ingrese y2:"
        Leer y2

    distancia <- Raiz((x2-x1)^2 + (y2-y1)^2)
    medioX <- (x1+x2)/2
    medioY <- (y1+y2)/2

      Escribir "Distancia: ", distancia
      Escribir "Punto medio: (", medioX, ",", medioY, ")"

FinAlgoritmo
