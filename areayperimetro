
Algoritmo AreaPerimetroRectangulo
    // Declaración de variables
      Definir largo, ancho, area, perimetro Como Real

    // Entrada de datos
      Escribir "Ingrese el largo del terreno en metros:"
        Leer largo

      Escribir "Ingrese el ancho del terreno en metros:"
        Leer ancho

    // Proceso
      area <- largo * ancho
      perimetro <- 2 * (largo + ancho)

    // Salida de resultados
      Escribir "El área del terreno es: ", area, " metros cuadrados"
      Escribir "El perímetro del terreno es: ", perimetro, " metros"
FinAlgoritmo


# Entrada de datos
largo = float(input("Ingrese el largo del terreno en metros: "))
ancho = float(input("Ingrese el ancho del terreno en metros: "))

# Proceso
area = largo * ancho
perimetro = 2 * (largo + ancho)

# Salida de resultados
print(f"El área del terreno es: {area:.2f} metros cuadrados")
print(f"El perímetro del terreno es: {perimetro:.2f} metros")
