Algoritmo BonoProductividad ()
  Inicio
    Definir sueldo, productividad Como Real
    Definir porcentaje, bono, total Como Real

      Escribir "Ingrese el sueldo base:"
        Leer sueldo
      Escribir "Ingrese el porcentaje de productividad:"
        Leer productividad

    Si productividad < 0 O productividad > 100 Entonces
      Escribir "Error: productividad no valida"
    SiNo
        Si productividad >= 90 Entonces
            porcentaje <- 20
        SiNo
            Si productividad >= 70 Entonces
                porcentaje <- 10
            SiNo
                Si productividad >= 50 Entonces
                    porcentaje <- 5
                SiNo
                    porcentaje <- 0
                FinSi
                  FinSi
                    FinSi

        bono <- sueldo * porcentaje / 100
        total <- sueldo + bono

          Escribir "Porcentaje de bono: ", porcentaje, "%"
          Escribir "Bono: $", bono
          Escribir "Total a pagar: $", total
    FinSi

FinAlgoritmo
