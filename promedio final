
Algoritmo PromedioFinal()
    // Declaraciones
          Definir A, B, C como Real
          Definir promedio como Real

    // Cuerpo
      Escribir "Ingrese nota 1er Parcial:"
        Leer A
    Mientras A < 0 o A > 10
      Escribir "Nota inválida, debe ser un número del 1 al 10"
        Leer A
    FinMientras

      Escribir "Ingrese nota 2do Parcial:"
        Leer B
    Mientras B < 0 o B > 10
      Escribir "Nota inválida, debe ser un número del 1 al 10"
        Leer B
    FinMientras

      Escribir "Ingrese nota 3er Parcial:"
        Leer C
    Mientras C < 0 o C > 10
        Escribir "Nota inválida, debe ser un número del 1 al 10"
        Leer C
    FinMientras

    promedio <- (A * 0.30) + (B * 0.30) + (C * 0.40)
    Mostrar promedio

    Si promedio >= 7
        Mostrar "Aprobado"
    Sino
        Mostrar "No Aprobado"
    FinSi
FinAlgoritmo
