
Algoritmo ContarAprobadosReprobados
    Definir N, i, aprobados, reprobados Como Entero
    Definir nota Como Real

    Escribir "Ingrese la cantidad de estudiantes:"
    Leer N

    aprobados <- 0
    reprobados <- 0
    i <- 1

    Mientras i <= N Hacer
        Escribir "Ingrese la nota del estudiante ", i, ":"
        Leer nota

        Si nota >= 7 Entonces
            aprobados <- aprobados + 1
        Sino
            reprobados <- reprobados + 1
        FinSi

        i <- i + 1
    FinMientras

    Escribir "Cantidad de aprobados: ", aprobados
    Escribir "Cantidad de reprobados: ", reprobados
FinAlgoritmo



N = int(input("Ingrese la cantidad de estudiantes: "))

aprobados = 0
reprobados = 0
i = 1

while i <= N:
    nota = float(input(f"Ingrese la nota del estudiante {i}: "))

    if nota >= 7:
        aprobados = aprobados + 1
    else:
        reprobados = reprobados + 1

    i = i + 1

print("Cantidad de aprobados:", aprobados)
print("Cantidad de reprobados:", reprobados)
