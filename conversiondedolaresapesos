
Algoritmo ConversionDolaresPesos
    // Declaración de variables
      Definir dolares, tipoCambio, pesos Como Real

    // Entrada de datos
      Escribir "Ingrese la cantidad en dólares:"
        Leer dolares

      Escribir "Ingrese el tipo de cambio actual:"
